# Copy to .env and fill in. NEVER commit .env.
# Phase 1 uses environment variables; Phase 2 migrates to Vault (ADR-0004).

# --- Data source credentials ---
FRED_API_KEY=your_fred_api_key_here
COINGECKO_API_KEY=your_coingecko_demo_key_here
# SEC EDGAR requires no key, but demands a descriptive User-Agent (FR-ING-004)
SEC_EDGAR_USER_AGENT="FinanceDataPlatform/0.1 (contact@example.com)"

# --- Local infrastructure (Phase 1 docker-compose) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=finance_platform
POSTGRES_USER=platform
POSTGRES_PASSWORD=change_me_locally

MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=change_me_locally
MINIO_SECRET_KEY=change_me_locally
MINIO_RAW_BUCKET=raw

# --- Serving API ---
API_KEY_SALT=change_me_locally
LOG_LEVEL=INFO
