# Secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.python-version

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Data — never commit raw or derived data
data/
*.parquet
*.duckdb
*.sqlite
*.db

# dbt
target/
dbt_packages/
logs/

# Dagster
.dagster/
dagster_home/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# Terraform / OpenTofu
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
